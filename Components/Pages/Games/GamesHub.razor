@page "/games"

<PageTitle>Games</PageTitle>

<div class="container-xxl py-3">
    <h1 style="color: var(--cf-theme-light)">
        <i class="bi bi-controller" style="color: var(--cf-theme-800)" />
        Games
    </h1>
    <p class="lead italic">
        Test your movie knowledge with fun challenges and trivia games.
    </p>
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">
        @foreach (var game in games)
        {
            <div class="col">
                <div class="card h-100" style="background-color: var(--cf-theme-900); border-color: var(--cf-theme-700);">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title" style="color: var(--cf-theme-light)">
                            <i class="@game.IconClass" />
                            @game.Title
                        </h5>
                        <p class="card-text" style="color: var(--cf-theme-400)">
                            @game.Description
                        </p>
                        <div class="mt-auto">
                            <span class="badge bg-secondary mb-3">@game.Difficulty</span>
                            <a href="@game.Route" class="btn btn-primary w-100">
                                <i class="bi bi-play-fill" /> Play
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<GameDefinition> games = new()
    {
        new GameDefinition(
            Title: "Mosaic Movie Mania",
            Description: "Guess the movie as the poster is revealed tile by tile!",
            Difficulty: "Medium",
            Route: "/games/mosaic",
            IconClass: "bi bi-grid-3x3-gap-fill"
        )
    };
}
